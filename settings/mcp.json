{
  "railway": {
    "type": "stdio",
    "command": "/opt/homebrew/bin/railway",
    "args": [
      "mcp"
    ],
    "env": {
      "PATH": "${PATH}"
    }
  },
  "google-drive": {
    "type": "stdio",
    "command": "${HOME}/.nvm/versions/node/v22.20.0/bin/npx",
    "args": [
      "-y",
      "@piotr-agier/google-drive-mcp"
    ],
    "env": {
      "PATH": "${PATH}"
    }
  },
  "chrome-devtools": {
    "type": "stdio",
    "command": "${HOME}/.nvm/versions/node/v22.20.0/bin/npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--headless",
      "--isolated",
      "--no-usage-statistics"
    ],
    "env": {
      "PATH": "${PATH}"
    }
  },
  "effectcraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/effectcraft-cli",
    "args": [
      "mcp",
      "--autosave"
    ],
    "env": {}
  },
  "filmcraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/filmcraft-cli",
    "args": [
      "mcp"
    ],
    "env": {}
  },
  "figcraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/figcraft-cli",
    "args": [
      "mcp"
    ],
    "env": {}
  },
  "vectorcraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/vectorcraft-cli",
    "args": [
      "mcp"
    ],
    "env": {}
  },
  "photocraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/photocraft-cli",
    "args": [
      "mcp",
      "--automation-read-root",
      "${HOME}",
      "--automation-write-root",
      "${HOME}/Craft"
    ],
    "env": {}
  },
  "lightcraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/lightcraft-cli",
    "args": [
      "mcp"
    ],
    "env": {}
  },
  "pdfcraft": {
    "type": "stdio",
    "command": "${HOME}/.local/bin/pdfcraft-cli",
    "args": [
      "mcp",
      "--compact",
      "--automation-read-root",
      "${HOME}",
      "--automation-write-root",
      "${HOME}/Craft"
    ],
    "env": {}
  },
  "gee-sweet": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/khuisman/mcp-gee-sweet@main",
      "mcp-gee-sweet"
    ],
    "env": {
      "CREDENTIALS_PATH": "${GEE_SWEET_CREDENTIALS_PATH}",
      "TOKEN_PATH": "${GEE_SWEET_TOKEN_PATH}"
    }
  }
}
