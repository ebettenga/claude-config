#!/usr/bin/env bash
# claude-as: run Claude Code (or any command) as one of your profiles.
#
#   claude-as                      list profiles
#   claude-as <profile> [args]     start claude as that profile (args go to claude)
#   claude-as <profile> shell      open a shell with that profile's accounts
#   claude-as <profile> exec CMD   run one command as that profile
#   claude-as <profile> status     show who each tool is signed in as
#   claude-as <profile> setup      first-time setup: plugins, Google, Railway token
#   claude-as <profile> open [DIR]  open a new terminal window running claude as that profile
#   claude-as new <profile>        create a profile from the template
#
# A profile is profiles/<name>.env in this repo: account names only, never
# secrets. Its data (Claude's config, sign-ins, history) lives in
# ~/.claude-profiles/<name>/ and is never committed.
set -euo pipefail

# Follow a symlinked claude-as (as installed in ~/.local/bin) back to this repo.
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
REPO="$(cd "$(dirname "$self")/.." && pwd)"
PROFILES="$REPO/profiles"
DATA_ROOT="${CLAUDE_AS_HOME:-$HOME/.claude-profiles}"
GDRIVE_HOME="$HOME/.config/google-drive-mcp"
KEYCHAIN_SERVICE="claude-as.railway"

die() { echo "claude-as: $*" >&2; exit 1; }
expand() { case "$1" in "~"/*) echo "$HOME/${1#\~/}" ;; "~") echo "$HOME" ;; *) echo "$1" ;; esac; }

list() {
  echo "Profiles (in $PROFILES):"
  for f in "$PROFILES"/*.env; do
    name="$(basename "$f" .env)"
    [ "$name" = _template ] && continue
    desc="$(sed -n 's/^PROFILE_DESC="\(.*\)"$/\1/p' "$f")"
    printf '  %-14s %s\n' "$name" "$desc"
  done
  echo
  echo "Start one with: claude-as <profile>"
}

load() {
  PROFILE="$1"
  local file="$PROFILES/$PROFILE.env"
  [ -f "$file" ] || die "no profile '$PROFILE' (see: claude-as)"
  GH_USER= SSH_KEY= GIT_NAME= GIT_EMAIL= GOOGLE_ACCOUNT= GCLOUD_CONFIG_DIR= RAILWAY=login AWS_PROFILE= PROFILE_DESC=
  # shellcheck disable=SC1090
  . "$file"
  DATA="$DATA_ROOT/$PROFILE"
  mkdir -p "$DATA/claude" "$DATA/gcloud" "$DATA/google-drive"
  chmod 700 "$DATA" "$DATA/google-drive"

  export CLAUDE_AS_PROFILE="$PROFILE"
  export CLAUDE_CONFIG_DIR="$DATA/claude"

  # GitHub: a token for that user from gh's own keyring, so nothing is copied.
  unset GH_TOKEN GITHUB_TOKEN
  if [ -n "$GH_USER" ]; then
    if token="$(gh auth token -u "$GH_USER" 2>/dev/null)"; then
      export GH_TOKEN="$token" GITHUB_TOKEN="$token"
    else
      echo "claude-as: gh is not signed in as $GH_USER (run: gh auth login)" >&2
    fi
  fi
  if [ -n "$SSH_KEY" ]; then
    export GIT_SSH_COMMAND="ssh -i $(expand "$SSH_KEY") -o IdentitiesOnly=yes"
  fi
  if [ -n "$GIT_NAME" ]; then export GIT_AUTHOR_NAME="$GIT_NAME" GIT_COMMITTER_NAME="$GIT_NAME"; fi
  if [ -n "$GIT_EMAIL" ]; then export GIT_AUTHOR_EMAIL="$GIT_EMAIL" GIT_COMMITTER_EMAIL="$GIT_EMAIL"; fi

  # Google MCP: a token file holding only this profile's account.
  export GOOGLE_DRIVE_MCP_TOKEN_PATH="$DATA/google-drive/tokens.json"
  [ -f "$GDRIVE_HOME/gcp-oauth.keys.json" ] && export GOOGLE_DRIVE_OAUTH_CREDENTIALS="$GDRIVE_HOME/gcp-oauth.keys.json"

  # gcloud: the profile's own config folder, or the one it names.
  if [ -n "$GCLOUD_CONFIG_DIR" ]; then export CLOUDSDK_CONFIG="$(expand "$GCLOUD_CONFIG_DIR")"; else export CLOUDSDK_CONFIG="$DATA/gcloud"; fi

  # Railway: a token from Keychain, or the computer's login. A token profile
  # with no token gets one that fails, rather than acting as the login.
  unset RAILWAY_API_TOKEN RAILWAY_TOKEN
  if [ "$RAILWAY" = token ]; then
    if token="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$PROFILE" -w 2>/dev/null)"; then
      export RAILWAY_API_TOKEN="$token"
    else
      export RAILWAY_API_TOKEN="no-token-run-claude-as-$PROFILE-setup"
    fi
  fi

  if [ -n "$AWS_PROFILE" ]; then export AWS_PROFILE; else unset AWS_PROFILE; fi
}

split_google() {
  local shared="$GDRIVE_HOME/tokens.json" mine="$DATA/google-drive/tokens.json"
  [ -n "$GOOGLE_ACCOUNT" ] || { echo "· Google: no account in this profile"; return; }
  [ -f "$mine" ] && { echo "· Google: already set up"; return; }
  [ -f "$shared" ] || { echo "· Google: no accounts yet. Add one inside Claude: manage_accounts add $GOOGLE_ACCOUNT"; return; }
  # Copies one account's record; prints no token.
  if python3 - "$shared" "$mine" "$GOOGLE_ACCOUNT" <<'PY'
import json, os, sys
src, dest, alias = sys.argv[1:]
store = json.load(open(src))
rec = store.get('accounts', {}).get(alias)
if not rec:
    sys.exit(1)
fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, 'w') as f:
    json.dump({'version': store.get('version', 2), 'accounts': {alias: rec}, 'defaultAccount': alias}, f, indent=2)
PY
  then echo "✓ Google: $GOOGLE_ACCOUNT copied into this profile"
  else echo "· Google: no '$GOOGLE_ACCOUNT' account in $shared. Add it inside Claude: manage_accounts add $GOOGLE_ACCOUNT"
  fi
}

setup() {
  echo "Setting up profile '$PROFILE' in $DATA"
  CLAUDE_CONFIG_DIR="$DATA/claude" "$REPO/install.sh"
  split_google
  if [ "$RAILWAY" = token ]; then
    if security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$PROFILE" >/dev/null 2>&1; then
      echo "· Railway: token already in Keychain"
    else
      echo "Railway: create an account token at https://railway.com/account/tokens while signed in as this profile's user."
      printf 'Store it in Keychain now? [y/N] '
      read -r answer || answer=
      if [ "$answer" = y ] || [ "$answer" = Y ]; then
        # -w with no value: security asks for the token itself, unechoed.
        security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$PROFILE" -w
        echo "✓ Railway: token stored"
      fi
    fi
  fi
  echo
  status
  echo
  echo "Next: claude-as $PROFILE   (sign in to Claude in that window the first time)"
}

status() {
  echo "Profile $PROFILE: $PROFILE_DESC"
  printf '  %-9s %s\n' Claude "$CLAUDE_CONFIG_DIR"
  if [ -n "${GH_TOKEN:-}" ]; then
    printf '  %-9s %s\n' GitHub "$(gh api user --jq .login 2>/dev/null || echo 'token rejected')"
  else
    printf '  %-9s %s\n' GitHub "not set"
  fi
  printf '  %-9s %s\n' git "${GIT_AUTHOR_NAME:-default} <${GIT_AUTHOR_EMAIL:-default}>"
  if [ -n "${GIT_SSH_COMMAND:-}" ]; then
    who="$($GIT_SSH_COMMAND -o BatchMode=yes -o ConnectTimeout=8 -T git@github.com 2>&1 | sed -n 's/^Hi \([^!]*\)!.*/\1/p' || true)"
    printf '  %-9s %s\n' "git push" "${who:-key not accepted by GitHub}"
  fi
  if [ -f "$GOOGLE_DRIVE_MCP_TOKEN_PATH" ]; then
    printf '  %-9s %s\n' Google "$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print(', '.join(a.get('email','?') for a in d.get('accounts',{}).values()))" "$GOOGLE_DRIVE_MCP_TOKEN_PATH")"
  else
    printf '  %-9s %s\n' Google "not set up (claude-as $PROFILE setup)"
  fi
  if command -v gcloud >/dev/null; then
    printf '  %-9s %s\n' gcloud "$(gcloud config get-value account 2>/dev/null || true)"
  fi
  if command -v railway >/dev/null; then
    printf '  %-9s %s\n' Railway "$(railway whoami 2>&1 | head -1 || true)"
  fi
  if [ -n "${AWS_PROFILE:-}" ]; then
    printf '  %-9s %s\n' AWS "profile $AWS_PROFILE"
  fi
}

open_window() {
  local dir="${1:-$PWD}" cmd app
  dir="$(cd "$dir" && pwd)" || die "no folder $1"
  cmd="cd $(printf '%q' "$dir") && $(printf '%q' "$REPO/bin/claude-as") $(printf '%q' "$PROFILE")"
  app="${CLAUDE_AS_TERMINAL:-}"
  if [ -z "$app" ]; then
    for candidate in Ghostty iTerm Terminal; do
      if [ -d "/Applications/$candidate.app" ] || [ -d "/System/Applications/Utilities/$candidate.app" ]; then app="$candidate"; break; fi
    done
  fi
  case "$app" in
    Ghostty) open -na Ghostty --args --working-directory="$dir" -e "$REPO/bin/claude-as" "$PROFILE" ;;
    iTerm)
      osascript - "$cmd" <<'OSA' >/dev/null
on run argv
  tell application "iTerm"
    activate
    create window with default profile command "/bin/zsh -lc " & quoted form of (item 1 of argv)
  end tell
end run
OSA
      ;;
    Terminal)
      osascript - "$cmd" "claude-as $PROFILE" <<'OSA' >/dev/null
on run argv
  tell application "Terminal"
    activate
    set t to do script (item 1 of argv)
    set custom title of t to (item 2 of argv)
  end tell
end run
OSA
      ;;
    *) die "no terminal app found (set CLAUDE_AS_TERMINAL to Ghostty, iTerm or Terminal)" ;;
  esac
  echo "Opened $app: claude as '$PROFILE' in $dir"
}

[ $# -eq 0 ] && { list; exit 0; }

if [ "$1" = new ]; then
  [ $# -ge 2 ] || die "usage: claude-as new <profile>"
  dest="$PROFILES/$2.env"
  [ -e "$dest" ] && die "profile '$2' exists"
  cp "$PROFILES/_template.env" "$dest"
  echo "Created $dest. Fill it in, then run: claude-as $2 setup"
  exit 0
fi

load "$1"
shift
case "${1:-}" in
  setup) setup ;;
  status) status ;;
  open) shift; open_window "${1:-}" ;;
  shell)
    echo "Shell as '$PROFILE'. Type exit to leave."
    exec "${SHELL:-/bin/zsh}" -i ;;
  exec)
    shift
    [ $# -gt 0 ] || die "usage: claude-as $PROFILE exec <command>"
    exec "$@" ;;
  *) exec claude "$@" ;;
esac
